/*
 * Media Controller shield
 *
 * 4 direct buttons (play/pause, next, prev, dedicated mute), 1 rotary
 * encoder (volume on turn; its own push button is unbound for now), an
 * analog joystick (cursor movement, click = left-click).
 *
 * Pin numbers below use the standard nice!nano "pro_micro" connector
 * index (defined in ZMK's arduino_pro_micro_pins.dtsi), which is
 * portable across nice_nano//zmk and any Pro-Micro-footprint nRF52840
 * clone (like the V1940) that shares the same pinout - VERIFY your
 * V1940's silkscreen labels against this table before soldering:
 *
 *   Signal              pro_micro index   Silkscreen label
 *   play/pause          4                 D4
 *   next                5                 D5
 *   prev                6                 D6
 *   mute                3                 D3
 *   encoder push        2                 D2 (unbound)
 *   joystick push       18 (P1.15)        A0
 *   encoder A           1                 D1
 *   encoder B           0                 D0
 *   joystick X (ADC)    19 (AIN0)         A1
 *   joystick Y (ADC)    20 (AIN5)         A2
 *
 * Only 3 pins on the nice!nano header are true ADC-capable pins - the
 * ones silkscreened A1/A2/A3 (SoC pins P0.02/P0.29/P0.31 = AIN0/AIN5/
 * AIN7, confirmed against Nordic's official nRF52840 datasheet). Every
 * other header pin, including the one labeled A0 (P1.15) and D10/D16
 * (P0.09/P0.10, which are dedicated NFC antenna pins), is NOT
 * SAADC-capable - don't route joystick X/Y to those regardless of any
 * label suggesting otherwise. That's why the buttons live on ordinary
 * digital pins (D3/D4/D5/D6) and joystick X/Y keep A1/A2 (D19/D20) for
 * themselves.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // play/pause
            , <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // next
            , <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // prev
            , <&pro_micro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // mute
            , <&pro_micro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // encoder push (unbound)
            , <&pro_micro 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // joystick push (left-click)
            ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <1>;
        //  play/pause  next    prev    mute    enc-push  joy-push
        map = <
            RC(0,0)     RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5)
        >;
    };

    left_encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };

    joystick: joystick {
        compatible = "zmk,analog-joystick";
        io-channels = <&adc 0>, <&adc 1>;
        deadzone = <150>;
        sensitivity = <24>;
        poll-interval-ms = <20>;
    };

    joystick_listener: joystick_listener {
        compatible = "zmk,input-listener";
        device = <&joystick>;
    };
};

&adc {
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
        zephyr,input-positive = <NRF_SAADC_AIN0>; // joystick X - pro_micro pin 19, silkscreen "A1"
        zephyr,resolution = <12>;
    };

    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
        zephyr,input-positive = <NRF_SAADC_AIN5>; // joystick Y - pro_micro pin 20, silkscreen "A2"
        zephyr,resolution = <12>;
    };
};
