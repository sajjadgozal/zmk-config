/*
 * Media Controller keymap
 *
 * Layout (physical positions 0-9):
 *   0: play/pause   1: next   2: prev   3: mute button (unbound)   4: encoder push (mute)   5: joystick push (left-click)
 *   6: joystick tilt right   7: joystick tilt left   8: joystick tilt down   9: joystick tilt up
 *   encoder turn: volume up / down
 *
 * Joystick X/Y are wired to non-ADC pins (see overlay comment) and read
 * as plain digital high/low, so positions 6-9 behave like a coarse
 * 4-direction digital stick (constant-speed cursor move while tilted
 * past center), not a smooth analog stick.
 *
 * Bluetooth profile switching (no dedicated buttons needed):
 *   hold prev + next together          -> select profile 0 (use for macOS)
 *   hold prev + play together          -> select profile 1 (use for TV)
 *   hold play + next + mute-btn        -> clear the currently active profile's pairing
 *   hold play + next + joy-push        -> toggle output between USB and BLE
 *
 * Pair to macOS: put device in profile 0 (prev+next combo), then pair from
 * System Settings > Bluetooth as usual.
 * Pair to a TV: switch to profile 1 (prev+play combo) and pair from the
 * TV's Bluetooth settings. Repeat the combo any time to swap which device
 * receives input - ZMK remembers both pairings.
 * Plug in a USB cable and use the output-toggle combo to switch to wired
 * mode any time (e.g. if BLE isn't available or you want zero latency).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_bt_mac {
            timeout-ms = <60>;
            key-positions = <2 1>;
            bindings = <&bt BT_SEL 0>;
        };

        combo_bt_tv {
            timeout-ms = <60>;
            key-positions = <2 0>;
            bindings = <&bt BT_SEL 1>;
        };

        combo_bt_clear {
            timeout-ms = <60>;
            key-positions = <0 1 3>;
            bindings = <&bt BT_CLR>;
        };

        combo_out_tog {
            timeout-ms = <60>;
            key-positions = <0 1 5>;
            bindings = <&out OUT_TOG>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp C_PP   &kp C_NEXT   &kp C_PREV   &none   &kp C_MUTE   &mkp LCLK
                &mmv MOVE_RIGHT   &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
