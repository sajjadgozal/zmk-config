/*
 * Media Controller keymap
 *
 * Layout (physical positions 0-5):
 *   0: play/pause   1: next   2: prev   3: mode-toggle button   4: encoder push (mute)   5: joystick push
 *   encoder turn: volume up / down (same in both layers)
 *
 * Two layers, toggled by the mode-toggle button (was spare/unbound):
 *   Layer 0 (mouse mode, default): joystick tilt moves the mouse
 *     cursor, joystick push = left-click.
 *   Layer 1 (arrow mode): joystick tilt sends arrow-key presses
 *     (held while tilted, released when centered), joystick push =
 *     Enter - a natural pairing for keyboard-style menu navigation.
 * play/pause, next, prev, mute, and volume are identical in both
 * layers. The joystick's actual behavior switch happens inside the
 * driver itself (drivers/input/analog_joystick.c watches whether layer
 * 1 is active), not here - it's a separate input-listener pipeline, not
 * a kscan position, so it has no keymap binding of its own.
 *
 * Bluetooth profile switching (no dedicated buttons needed, works from
 * either mode layer):
 *   hold prev + next together          -> select profile 0 (use for macOS)
 *   hold prev + play together          -> select profile 1 (use for TV)
 *   hold play + next + mode-toggle      -> clear the currently active profile's pairing
 *   hold play + next + joy-push         -> toggle output between USB and BLE
 *
 * Pair to macOS: put device in profile 0 (prev+next combo), then pair from
 * System Settings > Bluetooth as usual.
 * Pair to a TV: switch to profile 1 (prev+play combo) and pair from the
 * TV's Bluetooth settings. Repeat the combo any time to swap which device
 * receives input - ZMK remembers both pairings.
 * Plug in a USB cable and use the output-toggle combo to switch to wired
 * mode any time (e.g. if BLE isn't available or you want zero latency).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_bt_mac {
            timeout-ms = <60>;
            key-positions = <2 1>;
            bindings = <&bt BT_SEL 0>;
        };

        combo_bt_tv {
            timeout-ms = <60>;
            key-positions = <2 0>;
            bindings = <&bt BT_SEL 1>;
        };

        combo_bt_clear {
            timeout-ms = <60>;
            key-positions = <0 1 3>;
            bindings = <&bt BT_CLR>;
        };

        combo_out_tog {
            timeout-ms = <60>;
            key-positions = <0 1 5>;
            bindings = <&out OUT_TOG>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mouse_layer {
            bindings = <
                &kp C_PP   &kp C_NEXT   &kp C_PREV   &tog 1   &kp C_MUTE   &mkp LCLK
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        arrow_layer {
            bindings = <
                &kp C_PP   &kp C_NEXT   &kp C_PREV   &tog 1   &kp C_MUTE   &kp RET
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
