/*
 * Media Controller shield
 *
 * 3 direct buttons (prev, play/pause, next), 1 rotary encoder
 * (volume up/down on turn, mute on press), and an analog joystick
 * (cursor movement, click = left-click).
 *
 * Pin numbers below use the standard nice!nano "pro_micro" connector
 * index (defined in ZMK's arduino_pro_micro_pins.dtsi), which is
 * portable across nice_nano//zmk and any Pro-Micro-footprint nRF52840
 * clone (like the V1940) that shares the same pinout - VERIFY your
 * V1940's silkscreen labels against this table before soldering:
 *
 *   Signal              pro_micro index   Silkscreen label
 *   prev                4                 D4
 *   play/pause          5                 D5
 *   next                6                 D6
 *   encoder push (mute) 7                 D7
 *   joystick push       9                 D9
 *   encoder A           8                 D8
 *   encoder B           10                D10
 *   joystick X (ADC)    19 (AIN0)         A1
 *   joystick Y (ADC)    20 (AIN5)         A2
 *
 * Only 3 pins on the nice!nano header are true ADC-capable pins: the
 * ones silkscreened A1/A2/A3 (SoC pins P0.02/P0.29/P0.31 = AIN0/AIN5/
 * AIN7). The pin labeled A0 is NOT ADC-capable on this chip (routed to
 * P1.15, unlike a real Arduino) - don't use it for the joystick. That's
 * why joystick X/Y are wired to A1/A2 here, and the encoder was moved
 * off A2/A3 to free them up.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // prev
            , <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // play/pause
            , <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // next
            , <&pro_micro 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // encoder push (mute)
            , <&pro_micro 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // joystick push (left-click)
            ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <1>;
        //  prev    play/pause  next    enc-push  joy-push
        map = <
            RC(0,0) RC(0,1)     RC(0,2) RC(0,3)   RC(0,4)
        >;
    };

    left_encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };

    joystick: joystick {
        compatible = "zmk,analog-joystick";
        io-channels = <&adc 0>, <&adc 1>;
        deadzone = <150>;
        sensitivity = <24>;
        poll-interval-ms = <20>;
    };

    joystick_listener: joystick_listener {
        compatible = "zmk,input-listener";
        device = <&joystick>;
    };
};

&adc {
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
        zephyr,input-positive = <NRF_SAADC_AIN0>; // joystick X - pro_micro pin 19, silkscreen "A1"
        zephyr,resolution = <12>;
    };

    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
        zephyr,input-positive = <NRF_SAADC_AIN5>; // joystick Y - pro_micro pin 20, silkscreen "A2"
        zephyr,resolution = <12>;
    };
};
