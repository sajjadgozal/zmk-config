/*
 * Media Controller shield
 *
 * 4 direct buttons (play/pause, next, prev, dedicated mute), 1 rotary
 * encoder (volume on turn; its own push button is unbound for now), and
 * a joystick (click = left-click; X/Y tilt = coarse cursor movement).
 *
 * Pin numbers below use the standard nice!nano "pro_micro" connector
 * index (defined in ZMK's arduino_pro_micro_pins.dtsi), matching the
 * board as actually soldered:
 *
 *   Signal              pro_micro index   Silkscreen label
 *   play/pause          20                A2
 *   next                19                A1
 *   prev                21                A3
 *   mute                3                 D3
 *   encoder push        2                 D2 (unbound)
 *   joystick push       18 (P1.15)        A0
 *   encoder A           1                 D1
 *   encoder B           0                 D0
 *   joystick X          10 (P0.09)        D10
 *   joystick Y          16 (P0.10)        D16
 *
 * IMPORTANT - joystick X/Y are NOT true analog readings here. D10/D16
 * are P0.09/P0.10, the nRF52840's dedicated NFC1/NFC2 antenna pins -
 * confirmed against Nordic's official datasheet, these are not wired to
 * the chip's SAADC at all, in any devicetree/Kconfig configuration
 * (there is no "AIN5"/"AIN6" on these physical pins - that's a fixed
 * silicon fact, not a software setting). Only the pins silkscreened
 * A1/A2/A3 are true SAADC-capable pins on this board, and those are
 * occupied by the play/pause/next/prev buttons as soldered.
 *
 * So instead, this reads D10/D16 as plain digital GPIO: each pot's
 * wiper voltage is compared against the pin's fixed ~half-VCC digital
 * threshold, giving one bit per axis (tilted-this-way vs tilted-that-
 * way), which drives constant-speed cursor movement while held. This
 * needs CONFIG_NFCT_PINS_AS_GPIOS=y (see media_controller.conf) since
 * these pins default to NFC-antenna mode and aren't usable as GPIO at
 * all otherwise. Expect this to feel binary/jittery rather than a smooth
 * analog stick, and to chatter right around the joystick's mechanical
 * center if that happens to sit close to the pin's digital threshold.
 * If that's not good enough in practice, the real fix is re-wiring
 * joystick X/Y onto the A1/A2 pins instead (freeing them by moving the
 * 3 buttons onto ordinary digital pins like D4/D5/D6) - the previous
 * revision of this overlay did exactly that.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&pro_micro 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // play/pause
            , <&pro_micro 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // next
            , <&pro_micro 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // prev
            , <&pro_micro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // mute
            , <&pro_micro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // encoder push (unbound)
            , <&pro_micro 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // joystick push (left-click)
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH)>                // joystick X high half -> tilt right
            , <&pro_micro 10 (GPIO_ACTIVE_LOW)>                 // joystick X low half  -> tilt left
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH)>                // joystick Y high half -> tilt down
            , <&pro_micro 16 (GPIO_ACTIVE_LOW)>                 // joystick Y low half  -> tilt up
            ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <1>;
        //  play    next    prev    mute    enc-push  joy-push  x-hi    x-lo    y-hi    y-lo
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9)
        >;
    };

    left_encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };
};
