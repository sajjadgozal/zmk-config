/*
 * Media Controller keymap
 *
 * Layout (physical positions 0-5):
 *   0: play/pause (D16)   1: next (D10)   2: prev (A3)
 *   3: mode-toggle (D3)   4: encoder push / mute (D2)   5: joystick push (A0)
 *   encoder turn: volume up / down (all layers)
 *
 * Three output modes, each picked with a combo:
 *   hold prev + play               -> Bluetooth profile 0 (Mac)
 *   hold prev + next               -> Bluetooth profile 1 (Android TV)
 *   hold play + next + joy-push    -> cable (USB) mode
 *   hold play + next + mode-toggle -> forget the current BT profile's pairing
 * The two profile combos also switch output to Bluetooth, so they work
 * even with a cable plugged in (ZMK otherwise keeps sending over USB
 * whenever a cable is connected, whatever profile is selected).
 *
 * What the next/prev buttons send depends on the active output:
 *   profile 0 and cable: media next / previous track
 *   profile 1 (TV):      next = Home, prev = Back (mouse button 4)
 * That's the tv_layer below - it's switched on and off automatically by
 * src/endpoint_layer.c (CONFIG_ZMK_ENDPOINT_LAYER in
 * media_controller.conf) whenever the active output changes; there's no
 * keymap binding for it.
 *
 * TV keys:
 * back = mouse button 4 (MB4, a mouse's "back" side button). Android
 * turns it into the real system KEYCODE_BACK in its input reader, so no
 * app can swallow it. Escape was used before, but Android only maps
 * Escape to Back as a *fallback* when the focused app doesn't handle
 * Escape itself, so it worked in some apps and not others. The TV
 * remote's own Back (Consumer AC Back, 0x224) needs Full consumer
 * usages, which broke the other media keys on this TV.
 * home = Consumer "Media Select Home" (0x9A), within the Basic
 * consumer-usage range (see CONFIG_ZMK_HID_CONSUMER_REPORT_USAGES_BASIC
 * in media_controller.conf), unlike AC Home (0x223), which needs Full
 * and would reintroduce the Android compatibility issue Basic mode fixed.
 * NOTE: reported not to actually trigger Home on this TV - see README.
 *
 * joystick push in mouse mode sends BOTH a left-click and an Enter
 * keypress (click_or_enter macro below): some Android BLE hosts don't
 * register mouse-button clicks over BLE HID at all, so Enter rides along
 * as a keyboard-page fallback that's confirmed to work on the TV.
 *
 * Joystick modes, toggled by the mode-toggle button:
 *   Layer 0 (mouse mode, default): joystick tilt moves the mouse
 *     cursor, joystick push = left-click + Enter (see above).
 *   Layer 1 (arrow mode): joystick tilt sends arrow-key presses
 *     (held while tilted, released when centered), joystick push =
 *     Enter. The tilt behavior switch happens inside
 *     drivers/input/analog_joystick.c (it watches whether layer 1 is
 *     active), since the joystick isn't a keymap position.
 * Layer order matters: mouse_layer = 0, arrow_layer = 1 (must match the
 * joystick's arrow-layer in the overlay), tv_layer = 2 (must match
 * CONFIG_ZMK_ENDPOINT_LAYER_INDEX, default 2). tv_layer is highest so
 * its next/prev override both joystick modes.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    click_or_enter: click_or_enter {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&mkp LCLK>, <&kp RET>;
    };

    bt_mac: bt_mac {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&bt BT_SEL 0>, <&out OUT_BLE>;
    };

    bt_tv: bt_tv {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&bt BT_SEL 1>, <&out OUT_BLE>;
    };

    combos {
        compatible = "zmk,combos";

        combo_bt_mac {
            timeout-ms = <60>;
            key-positions = <2 0>;  // prev + play
            bindings = <&bt_mac>;
        };

        combo_bt_tv {
            timeout-ms = <60>;
            key-positions = <2 1>;  // prev + next
            bindings = <&bt_tv>;
        };

        combo_bt_clear {
            timeout-ms = <60>;
            key-positions = <0 1 3>;  // play + next + mode-toggle
            bindings = <&bt BT_CLR>;
        };

        combo_out_usb {
            timeout-ms = <60>;
            key-positions = <0 1 5>;  // play + next + joy-push
            bindings = <&out OUT_USB>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mouse_layer {
            bindings = <
                &kp C_PP   &kp C_NEXT   &kp C_PREV   &tog 1   &kp C_MUTE   &click_or_enter
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        arrow_layer {
            bindings = <
                &trans     &trans       &trans       &trans   &trans       &kp RET
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        tv_layer {
            bindings = <
                &trans     &kp C_MEDIA_HOME   &mkp MB4   &trans   &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
